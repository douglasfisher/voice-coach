# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies (each workspace + pnpm shared store)
node_modules/
.pnpm-store/

# Expo (apply to any apps/* workspace)
**/.expo/
**/dist/
**/web-build/
**/expo-env.d.ts

# Next.js (admin app)
**/.next/
**/out/

# Native folders (Expo prebuild output — mobile workspace only)
apps/mobile/ios/
apps/mobile/android/

# Editor / OS
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
.DS_Store
*.pem

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# Local env (every workspace; never commit secrets)
.env
.env*.local
**/.env
**/.env*.local

# TypeScript build cache
**/*.tsbuildinfo

# Test artefacts
.test-status
**/coverage/
