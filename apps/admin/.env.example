# Supabase project (Dialectica)
NEXT_PUBLIC_SUPABASE_URL=https://enatcutnrtuauykqyajc.supabase.co

# Publishable key — safe in the browser. New 2025 format: sb_publishable_*
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key — server-only, NEVER prefix with NEXT_PUBLIC_. New 2025 format: sb_secret_*
# Bypasses RLS. Treat like a root credential.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated list of origins allowed to call /api/admin/*
# In production set to https://admin.dialectica.app
ADMIN_ALLOWED_ORIGINS=http://localhost:4837
