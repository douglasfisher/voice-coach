# pnpm settings for the monorepo.
#
# shamefully-hoist=true: Metro (React Native bundler) doesn't follow
# pnpm's symlinked node_modules layout reliably. Hoisting deps to a
# flat node_modules at each workspace root sidesteps that — Expo's docs
# call this out as the recommended setting for pnpm workspaces.
#
# legacy-peer-deps inherited from the previous npm-based config because
# Expo SDK still ships some packages with strict peer ranges that
# routinely conflict with React 19.
shamefully-hoist=true
legacy-peer-deps=true
