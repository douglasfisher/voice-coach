# =============================================================================
# DIALECTICA ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# MOBILE APP (Expo)
# These are bundled into the app - use EXPO_PUBLIC_ prefix
# -----------------------------------------------------------------------------

# Supabase Configuration (Required)
# Find these in: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ElevenLabs TTS (Optional - for voice features)
EXPO_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# -----------------------------------------------------------------------------
# EDGE FUNCTIONS (Supabase)
# Set these via: npx supabase secrets set KEY=value
# -----------------------------------------------------------------------------

# Groq API Key (Required for AI features)
# Get yours at: https://console.groq.com/keys
# Set via: npx supabase secrets set GROQ_API_KEY=your-key
# GROQ_API_KEY=your-groq-api-key

# ElevenLabs API Key (Optional - for TTS edge function)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by Supabase into edge functions - no need to set these manually
