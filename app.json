{
  "expo": {
    "name": "Dialectica",
    "slug": "dialectica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "dialectica",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dialectica.app",
      "usesAppleSignIn": true,
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow Dialectica to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow Dialectica to use your microphone for voice input.",
        "NSPhotoLibraryUsageDescription": "Dialectica may access your photo library to save or select images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F12"
      },
      "package": "com.dialectica.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-av",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Dialectica to use your microphone for voice input.",
          "speechRecognitionPermission": "Allow Dialectica to use speech recognition."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eb118027-487b-434e-a947-7de1c44e9b57"
      }
    },
    "owner": "douglas-fisher"
  }
}
